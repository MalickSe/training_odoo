<odoo>

    <template id="report_mission_terrain">

        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">

                <!-- TITRE -->
                <h2 style="text-align:center; color:#4B6EA8;">ORDRE DE MISSION</h2>

                <br/>

                <!-- INFOS GENERALES -->
                <table style="width:100%;">
                    <tr>
                        <td><strong>Référence :</strong></td>
                        <td><span t-field="doc.name"/></td>

                        <td><strong>Projet :</strong></td>
                        <td><span t-field="doc.project_id.name"/></td>
                    </tr>

                    <tr>
                        <td><strong>Objet :</strong></td>
                        <td><span t-field="doc.objet"/></td>

                        <td><strong>Destination :</strong></td>
                        <td><span t-field="doc.destination"/></td>
                    </tr>
                </table>

                <br/>

                <!-- DATES -->
                <h3>Planning</h3>
                <table style="width:100%;" class="table table-sm table-bordered">
                    <tr>
                        <th>Date départ</th>
                        <th>Heure départ</th>
                        <th>Date retour</th>
                        <th>Heure retour</th>
                    </tr>
                    <tr>
                        <td><span t-field="doc.date_depart"/></td>
                        <td><span t-field="doc.heure_depart"/></td>
                        <td><span t-field="doc.date_retour"/></td>
                        <td><span t-field="doc.heure_retour"/></td>
                    </tr>
                </table>

                <br/>

                <!-- LOGISTIQUE -->
                <h3>Logistique</h3>

                <table class="table table-bordered table-sm"
                       style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th>Véhicule</th>
                            <th>Immatriculation</th>
                            <th>Chauffeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <t t-if="doc.vehicle_id">
                                    <span t-field="doc.vehicle_id.name"/>
                                </t>
                            </td>
                            <td>
                                <t t-if="doc.vehicle_id">
                                    <span t-field="doc.vehicle_id.license_plate"/>
                                </t>
                            </td>
                            <td>
                                <t t-if="doc.driver_id">
                                    <span t-field="doc.driver_id.name"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br/>

                <!-- PARTICIPANTS -->
                <h3>Participants</h3>

                <table class="table table-bordered table-sm"
                       style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Rôle</th>
                            <th>Per diem</th>
                            <th>Ligne budgetaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.participant_ids" t-as="p">
                            <td>
                                <span t-field="p.user_id.name"/>
                            </td>
                            <td>
                                <span t-field="p.role"/>
                            </td>
                            <td>
                                <span t-field="p.total_per_diem"/>
                            </td>
                            <td>
                                <span t-field="doc.ligne_budgetaire"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br/>

                <h3>TDR</h3>
                <div t-field="doc.tdr_note"/>

                <br/><br/>

                <!-- SIGNATURE ZONE -->
                <table style="width:100%; text-align:center;">
                    <tr>
                        <td>
                            <strong>Demandeur</strong><br/>
                            ______________________
                        </td>


                <!-- Security -->
                        <td>
                            <strong>Validation Sécurité</strong><br/>

                            <t t-if="doc.validated_by_security">
                                <img t-att-src="'/web/image/res.users/%s/signature_image' % doc.validated_by_security.id" style="height:70px; width:auto;"/>
                            </t>

                            <br/>

                            <span t-field="doc.validated_by_security.name"/>
                        </td>



                    <td>
                        <strong>Approbation</strong><br/>

                        <t t-if="doc.approved_by">
                                <img t-att-src="'/web/image/res.users/%s/signature_image' % doc.approved_by.id" style="height:70px; width:auto;"/>
                            </t>

                        <br/>

                        <span t-field="doc.approved_by.name"/>
                    </td>

                    </tr>
                </table>

            </t>
        </t>

    </template>

<record id="action_report_mission" model="ir.actions.report">
    <field name="name">Ordre de mission</field>
    <field name="model">mission.terrain</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">mission_terrain.report_mission_terrain</field>
    <field name="print_report_name">'Ordre Mission - %s' % (object.name)</field>
</record>

</odoo>