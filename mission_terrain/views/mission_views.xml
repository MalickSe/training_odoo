<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--  FORM -->
    <record id="view_mission_form" model="ir.ui.view">
    <field name="name">mission.terrain.form</field>
    <field name="model">mission.terrain</field>
    <field name="arch" type="xml">

        <form string="Mission Terrain">

            <!--  HEADER WORKFLOW -->
   <header>

    <button name="action_submit"
            type="object"
            string="Soumettre"
            class="btn-primary"
            invisible="state != 'draft'"/>

    <button name="action_validate_security"
            type="object"
            string="Validation Sécurité"
            invisible="state != 'submitted'"/>

    <button name="action_assign_fleet"
            type="object"
            string="Traitement Flotte"
            invisible="state != 'security'"/>

    <button name="action_validate_finance"
            type="object"
            string="Validation Finance"
            invisible="state != 'fleet'"/>

    <button name="action_approve"
            type="object"
            string="Approuver"
            class="btn-success"
            invisible="state != 'finance'"/>

    <button name="action_reject"
            type="object"
            string="Rejeter"
            class="btn-danger"
            invisible="state not in ['submitted','security','fleet','finance']"/>

    <field name="state" widget="statusbar"/>

</header>

            <sheet>

                <!--  SMART BUTTON (bonus) -->
                <div class="oe_button_box" name="button_box">
                    <button type="object"
                            name="action_view_participants"
                            class="oe_stat_button"
                            icon="fa-users">
                        <field name="participant_count" widget="statinfo"
                               string="Participants"/>
                    </button>
                </div>


                <!--  INFOS GÉNÉRALES -->
                <group>
                    <group>
                        <field name="name"/>
                        <field name="objet"/>
                        <field name="destination"/>
                        <field name="mission_type"/>
                        <field name="project_id"/>
                    </group>

                    <group>
                        <field name="date_depart"/>
                        <field name="heure_depart"/>
                        <field name="date_retour"/>
                        <field name="heure_retour"/>
                    </group>
                </group>

                <!--  LOGISTIQUE -->
                <group string="Logistique">
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                </group>

                <!--  FINANCE -->
                <group string="Finance">
                    <field name="ligne_budgetaire"/>
                    <field name="requested_amount"/>
                    <field name="approved_amount"/>
                </group>

                <!--  DOCUMENT -->
                <group string="TDR">
                    <field name="tdr_file" filename="tdr_filename"/>
                </group>

                <!--  PARTICIPANTS -->
                <notebook>
                    <page string="Participants">
                        <field name="participant_ids">
                            <list editable="bottom">
                                <field name="user_id"/>
                                <field name="role"/>
                                <field name="is_driver"/>
                                <field name="per_diem"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <!--  CHATTER -->
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </sheet>

        </form>

    </field>
</record>


    <!--  LIST -->
    <record id="view_mission_list" model="ir.ui.view">
    <field name="name">mission.terrain.list</field>
    <field name="model">mission.terrain</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="objet"/>
            <field name="destination"/>
            <field name="mission_type"/>
            <field name="date_depart"/>
            <field name="requester_id"/>
            <field name="state"/>
        </list>
    </field>
</record>


    <!--  ACTION -->

<record id="action_mission" model="ir.actions.act_window">
    <field name="name">Missions</field>
    <field name="res_model">mission.terrain</field>
    <field name="view_mode">list,form</field>
</record>


    <!--  MENUS -->
    <menuitem id="menu_mission_root" name="Missions Terrain"/>
    <menuitem id="menu_mission" name="Missions"
              parent="menu_mission_root"
              action="action_mission"/>

</odoo>
