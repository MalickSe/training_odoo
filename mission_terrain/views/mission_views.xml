<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--  FORM -->
    <record id="view_mission_form" model="ir.ui.view">
    <field name="name">mission.terrain.form</field>
    <field name="model">mission.terrain</field>
    <field name="arch" type="xml">

        <form string="Mission Terrain">

            <!--  HEADER WORKFLOW -->
   <header>

    <button name="action_submit"
            type="object"
            string="Soumettre"
            class="btn-primary"
            groups="mission_terrain.group_mission_user"
             invisible="state != 'draft'"/>

    <button name="action_validate_security"
            type="object"
            string="Validation Sécurité"
            groups="mission_terrain.group_mission_security"
            invisible="state != 'submitted'"/>

    <button name="action_assign_fleet"
            type="object"
            string="Traitement Flotte"
            groups="mission_terrain.group_mission_fleet"
            invisible="state != 'security'"/>

    <button name="action_validate_finance"
            type="object"
            string="Validation Finance"
            groups="mission_terrain.group_mission_finance"
            invisible="state != 'fleet'"/>

    <button name="action_approve"
            type="object"
            string="Approuver"
            class="btn-success"
            groups="mission_terrain.group_mission_manager"
             invisible="state != 'finance'"/>

    <button name="action_done"
            type="object"
            string="Terminer"
            class="btn-success"
            groups="mission_terrain.group_mission_manager"
            invisible="state != 'approval'"/>

    <button name="action_reject"
            type="object"
            string="Rejeter"
            class="btn-danger"
            invisible="state not in ['submitted','security','fleet','finance','approval']"/>

    <button name="%(action_report_mission)d"
            string="Imprimer OM"
            type="action"
            class="btn-secondary"
            invisible="state not in ['done','review_finance','closed']"/>

    <button name="%(mission_terrain.action_report_mission_finance)d"
            type="action"
            string="Demande d'avance"
            class="btn-primary"
            invisible="state not in ['finance','approval','done','review_finance','closed']"/>


    <button name="action_start_review"
            type="object"
            string="Revue Finance"
            class="btn-warning"
            groups="mission_terrain.group_mission_finance"
            invisible="state != 'done'"/>


    <button name="action_close"
            type="object"
            string="Clôturer"
            class="btn-success"
            groups="mission_terrain.group_mission_finance"
            invisible="state != 'review_finance'"/>



    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,security,fleet,finance,approval,done,review_finance,closed"/>

</header>

            <sheet>

                <!--  SMART BUTTON (bonus) -->
                <div class="oe_button_box" name="button_box">
                    <button type="object"
                            name="action_view_participants"
                            class="oe_stat_button"
                            icon="fa-users">
                        <field name="participant_count" widget="statinfo"
                               string="Participants"/>
                    </button>
                </div>


                <!--  INFOS GÉNÉRALES -->
                <group>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="objet" readonly="state != 'draft'"/>
                        <field name="destination" readonly="state != 'draft'"/>
                        <field name="mission_type" readonly="state != 'draft'"/>
                        <field name="project_id" readonly="state != 'draft'"/>
                    </group>

                    <group>
                        <field name="date_depart" readonly="state != 'draft'"/>
                        <field name="heure_depart" readonly="state != 'draft'"/>
                        <field name="date_retour" readonly="state != 'draft'"/>
                        <field name="heure_retour" readonly="state != 'draft'"/>
                        <field name="nb_days" readonly="1"/>
                    </group>
                </group>

                <!--  LOGISTIQUE -->

            <group string="Logistique"
                   groups="mission_terrain.group_mission_fleet,mission_terrain.group_mission_finance,mission_terrain.group_mission_manager">

                <field name="vehicle_id"
                       invisible="state not in ['fleet','finance','approval','done']"
                       readonly="state != 'fleet'"/>

                <field name="driver_id"
                       invisible="state not in ['fleet','finance','approval','done']"
                       readonly="state != 'fleet'"/>

            </group>

                <!--  FINANCE -->
                <group string="Finance">
                    <field name="ligne_budgetaire" readonly="state != 'finance'" invisible="state not in ['finance','approval','done']"/>
                    <field name="requested_amount" readonly="1"/>


                    <!--  Hébergement -->
                        <field name="hebergement_journalier"
                               readonly="state != 'finance'"
                               invisible="state not in ['finance','approval','done','review_finance','closed']"/>

                        <field name="hebergement_total"
                               readonly="1"
                               invisible="state not in ['finance','approval','done','review_finance','closed']"/>

                    <!--  Transport -->
                        <field name="transport_amount"
                               readonly="state != 'finance'"
                               invisible="state not in ['finance','approval','done','review_finance','closed']"/>

                     <!-- Total final -->
                        <field name="approved_amount"
                               readonly="1" style="font-weight:bold; font-size:16px;" invisible="state not in ['finance','approval','done','review_finance','closed']"/>

                    <!-- Ecart Budget -->

                        <field name="actual_amount"
                               groups="mission_terrain.group_mission_finance"
                               readonly="state != 'review_finance'"/>

                        <field name="budget_variance"
                               readonly="1" decoration-danger="budget_variance &gt; 0" decoration-success="budget_variance &lt; 0"/>

                        <field name="variance_status"
                               readonly="1"/>


                </group>

                <!--  DOCUMENT -->

                <group string="TDR">

<field name="tdr_note" widget="html" placeholder="Saisir les termes de référence..." readonly="state != 'draft'"/>

                </group>


                <!--  PARTICIPANTS -->
                <notebook>
                    <page string="Participants">
                        <field name="participant_ids">
                            <list editable="bottom">
                                <field name="user_id"/>
                                <field name="role"/>
                                <field name="is_driver"/>
                                <field name="per_diem"/>
                                <field name="nb_days" readonly="1"/>
                                <field name="total_per_diem" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <!--  CHATTER -->
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </sheet>

        </form>

    </field>
</record>

    <!--  LIST -->
    <record id="view_mission_list" model="ir.ui.view">
    <field name="name">mission.terrain.list</field>
    <field name="model">mission.terrain</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="objet"/>
            <field name="destination"/>
            <field name="mission_type"/>
            <field name="date_depart"/>
            <field name="requester_id"/>
            <field name="state"/>
        </list>
    </field>
</record>


    <!--  ACTION -->

<record id="action_mission" model="ir.actions.act_window">
    <field name="name">Missions</field>
    <field name="res_model">mission.terrain</field>
    <field name="view_mode">list,form</field>
</record>


    <!--  MENUS -->
    <menuitem id="menu_mission_root" name="Missions Terrain"/>
    <menuitem id="menu_mission" name="Missions"
              parent="menu_mission_root"
              action="action_mission"/>

</odoo>
