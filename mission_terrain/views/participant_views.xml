<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="view_participant_list" model="ir.ui.view">
    <field name="name">mission.participant.list</field>
    <field name="model">mission.participant</field>
    <field name="arch" type="xml">
        <list>
            <field name="user_id"/>
            <field name="partner_id"/>
            <field name="role"/>
            <field name="is_driver"/>
            <field name="per_diem"/>
        </list>
    </field>
</record>

<record id="view_participant_form" model="ir.ui.view">
    <field name="name">mission.participant.form</field>
    <field name="model">mission.participant</field>
    <field name="arch" type="xml">
        <form string="Participant">
            <sheet>
                <group>
                    <field name="mission_id"/>
                    <field name="user_id"/>
                    <field name="partner_id"/>
                    <field name="role"/>
                    <field name="is_driver"/>
                    <field name="per_diem"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>