<odoo>

    <record id="seq_mission_terrain" model="ir.sequence">
        <field name="name">Mission Terrain</field>
        <field name="code">mission.terrain</field>
        <field name="prefix">MT/SEN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
    </record>

<record id="seq_mission_deplacement" model="ir.sequence">
    <field name="name">Déplacement Journalier</field>
    <field name="code">mission.deplacement</field>
    <field name="prefix">DPL/SEN/%(year)s/</field>
    <field name="padding">4</field>
    <field name="number_increment">1</field>
</record>


</odoo>
